# Brain
OLLAMA_HOST=http://localhost:11434
# Model with tools and optional thinking (try qwen3.5:2b if it's too slow)
LLM_MODEL=qwen3.5:4b
# 1 = the model thinks before each round: chains tools better, but slower
LLM_THINK=1
# 1 = everything on the CPU, to simulate the target box
LLM_CPU_ONLY=1
# CPU threads for the LLM: set the core count of the target box (4 for a Pi 5 / N100)
LLM_THREADS=4
# Context: at least 8192 with web search (one page read is ~1000 tokens)
LLM_CTX=8192

# Internet: 1 = the assistant can search the web (DuckDuckGo, no key) and read pages
WEB_SEARCH=1
# City or neighbourhood, for "the cinema nearby", "the weather"… (e.g. Lyon 7e)
HOME_LOCATION=

# Ear: tiny, base, small (small = good trade-off for French)
WHISPER_MODEL=small
WHISPER_LANGUAGE=fr
WHISPER_THREADS=4

# Voice
PIPER_VOICE=models/fr_FR-siwis-medium.onnx

# Wake word: "Prométhée", a custom openWakeWord model to train (see README).
# Built-in English models also work: hey_jarvis, alexa, hey_mycroft…
WAKE_WORD=models/promethee.onnx
WAKE_THRESHOLD=0.5
# Seconds kept from just before the detection, for "hey jarvis what time is it" in one breath
WAKE_PREROLL_S=0.25
# After an answer, listen this long for a follow-up without the wake word (0 = off)
FOLLOW_UP_S=10

# Audio (index or name, empty = default device; `python -m sounddevice` lists them)
INPUT_DEVICE=
OUTPUT_DEVICE=
